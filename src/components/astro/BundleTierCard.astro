---
interface Props {
  tier: 'standard' | 'premium';
  displayName: string;
  tagline: string | null;
  slotCount: number;
  basePriceCents: number;
  perSlotSavingsCents: number;
}

const { tier, displayName, tagline, slotCount, basePriceCents, perSlotSavingsCents } = Astro.props;

import { formatPrice } from '@/lib/pricing';
const isPremium = tier === 'premium';
const totalSavings = perSlotSavingsCents * slotCount;
---

<div class={`relative flex flex-col p-8 rounded-[var(--radius-card)] border-2 ${isPremium ? 'border-[var(--color-brand)] bg-[var(--color-surface-base)] shadow-[var(--shadow-rail)]' : 'border-[var(--color-surface-sunken)] bg-[var(--color-surface-elevated)]'}`}>
  {isPremium && (
    <div class="absolute -top-4 left-1/2 -translate-x-1/2">
      <span class="bg-[var(--color-brand)] text-[var(--color-surface-elevated)] text-[12px] font-bold uppercase tracking-wider px-4 py-1.5 rounded-full shadow-md">
        Most Popular
      </span>
    </div>
  )}

  <div class="text-center mb-8">
    <h3 class="font-[family-name:var(--font-display)] font-bold text-[28px] text-[var(--color-fg)] mb-2">{displayName}</h3>
    {tagline && <p class="text-[var(--color-fg-muted)] text-[16px]">{tagline}</p>}
  </div>

  <div class="flex items-end justify-center gap-1 mb-8">
    <span class="text-[40px] font-bold text-[var(--color-brand)] leading-none">{formatPrice(basePriceCents)}</span>
    <span class="text-[var(--color-fg-subtle)] text-[14px] font-medium mb-1">/ {slotCount} meals</span>
  </div>

  <div class="space-y-4 mb-8 flex-1">
    <div class="flex items-center gap-3">
      <svg class="text-[var(--color-brand)] w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span class="text-[14px] text-[var(--color-fg)]">Fully customizable menu</span>
    </div>
    <div class="flex items-center gap-3">
      <svg class="text-[var(--color-brand)] w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span class="text-[14px] text-[var(--color-fg)]">Macro-tracked portions</span>
    </div>
    <div class="flex items-center gap-3">
      <svg class="text-[var(--color-brand)] w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span class="text-[14px] text-[var(--color-fg)]">Delivered fresh, never frozen</span>
    </div>
    {totalSavings > 0 && (
      <div class="flex items-center gap-3 mt-4 pt-4 border-t border-[var(--color-surface-sunken)]">
        <span class="text-[var(--color-accent)] font-semibold text-[14px]">
          Save {formatPrice(totalSavings)} vs standard pricing
        </span>
      </div>
    )}
  </div>

  <a 
    href={`/build?tier=${tier}`} 
    class={`w-full py-4 rounded-[var(--radius-pill)] font-semibold text-[16px] text-center transition-colors ${
      isPremium 
        ? 'bg-[var(--color-brand)] text-[var(--color-surface-elevated)] hover:bg-[var(--color-brand-hover)]' 
        : 'bg-[var(--color-surface-sunken)] text-[var(--color-brand)] hover:bg-[var(--color-brand-soft)]'
    }`}
  >
    Select {slotCount} Meals
  </a>
</div>
