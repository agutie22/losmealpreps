---
import '@/styles/globals.css';
import { getSiteSettings } from '@/lib/queries/settings';
import CartWidget from '@/components/react/public/CartWidget';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "Premium Meal Prep, Delivered", image = '/og-image.svg' } = Astro.props;
const settings = await getSiteSettings();
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Los Meal Preps — Premium meal prep and macro-tracked plans." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[var(--color-surface-base)] text-[var(--color-fg)] font-[family-name:var(--font-body)] min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 w-full bg-[var(--color-surface-base)]/80 backdrop-blur-md border-b border-[var(--color-surface-sunken)]">
      <div class="container mx-auto px-4 sm:px-6 h-[72px] flex items-center justify-between gap-3">
        <a href="/" class="font-[family-name:var(--font-display)] font-bold text-[20px] sm:text-[24px] tracking-tight text-[var(--color-brand)] truncate">Los Meal Preps</a>
        <nav class="hidden md:flex items-center gap-8 text-[14px] font-medium text-[var(--color-fg-muted)]">
          <a href="/#how-it-works" class="hover:text-[var(--color-brand)] transition-colors">How It Works</a>
          <a href="/#menu" class="hover:text-[var(--color-brand)] transition-colors">Menu</a>
          <a href="/#bundles" class="hover:text-[var(--color-brand)] transition-colors">Bundles</a>
          <a href="/customize" class="hover:text-[var(--color-brand)] transition-colors">Custom Meal</a>
          <a href="/consult" class="hover:text-[var(--color-brand)] transition-colors">Consultation</a>
        </nav>
        <div class="flex items-center gap-2 sm:gap-4">
          <CartWidget client:only="react" igHandle={settings.instagram_handle ?? 'losmealpreps'} />
          <a
            href="/#bundles"
            class="hidden md:inline-flex items-center justify-center bg-[var(--color-brand)] text-[var(--color-surface-elevated)] px-6 py-2.5 rounded-[var(--radius-pill)] text-[14px] font-medium hover:bg-[var(--color-brand-hover)] transition-colors"
          >
            Start Building
          </a>
          <button id="mobile-menu-toggle" class="md:hidden text-[var(--color-brand)] p-2" aria-label="Toggle menu" aria-expanded="false">
            <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
            <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-surface-sunken)]">
        <nav class="container mx-auto px-6 py-4 flex flex-col gap-1 text-[14px] font-medium">
          <a href="/#how-it-works" class="py-3 text-[var(--color-fg-muted)] hover:text-[var(--color-brand)] transition-colors">How It Works</a>
          <a href="/#menu" class="py-3 text-[var(--color-fg-muted)] hover:text-[var(--color-brand)] transition-colors">Menu</a>
          <a href="/#bundles" class="py-3 text-[var(--color-fg-muted)] hover:text-[var(--color-brand)] transition-colors">Bundles</a>
          <a href="/customize" class="py-3 text-[var(--color-fg-muted)] hover:text-[var(--color-brand)] transition-colors">Custom Meal</a>
          <a href="/consult" class="py-3 text-[var(--color-fg-muted)] hover:text-[var(--color-brand)] transition-colors">Consultation</a>
          <a href="/#bundles" class="mt-2 inline-flex items-center justify-center bg-[var(--color-brand)] text-[var(--color-surface-elevated)] px-6 py-2.5 rounded-[var(--radius-pill)] hover:bg-[var(--color-brand-hover)] transition-colors">Start Building</a>
        </nav>
      </div>
    </header>

    <script>
      const toggle = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');
      const closeMobileMenu = () => {
        menu?.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        toggle?.setAttribute('aria-expanded', 'false');
      };

      toggle?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!isOpen));
        if (!isOpen) window.dispatchEvent(new CustomEvent('mobile-menu:open'));
      });

      menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          closeMobileMenu();
        });
      });

      window.addEventListener('cart:open', closeMobileMenu);
    </script>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-[var(--color-surface-inverse)] text-[var(--color-fg-inverse)] py-6 md:py-10 mt-6 md:mt-12">
      <div class="container mx-auto px-4 sm:px-6 grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-8">
        <div class="col-span-2 md:col-span-1">
          <h3 class="font-[family-name:var(--font-display)] font-bold text-[20px] md:text-[24px] mb-2 md:mb-3">Los Meal Preps</h3>
          <p class="text-[var(--color-fg-subtle)] text-[13px] md:text-[14px] max-w-xs leading-snug md:leading-relaxed">
            {settings.tagline}
          </p>
        </div>
        <div>
          <h4 class="font-bold text-[14px] md:text-[16px] mb-2 md:mb-4">Links</h4>
          <ul class="space-y-1 md:space-y-2 text-[13px] md:text-[14px] text-[var(--color-fg-subtle)]">
            <li><a href="/#how-it-works" class="hover:text-[var(--color-fg-inverse)] transition-colors">How It Works</a></li>
            <li><a href="/#menu" class="hover:text-[var(--color-fg-inverse)] transition-colors">Menu</a></li>
            <li><a href="/#bundles" class="hover:text-[var(--color-fg-inverse)] transition-colors">Bundles</a></li>
            <li><a href="/customize" class="hover:text-[var(--color-fg-inverse)] transition-colors">Custom Meal</a></li>
            <li><a href="/consult" class="hover:text-[var(--color-fg-inverse)] transition-colors">Consultation</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-[14px] md:text-[16px] mb-2 md:mb-4">Contact</h4>
          <ul class="space-y-1 md:space-y-2 text-[13px] md:text-[14px] text-[var(--color-fg-subtle)]">
            <li><a href={`mailto:${settings.contact_email}`} class="hover:text-[var(--color-fg-inverse)] transition-colors">{settings.contact_email}</a></li>
            {settings.instagram_handle && (
              <li><a href={`https://instagram.com/${settings.instagram_handle}`} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-fg-inverse)] transition-colors">@{settings.instagram_handle}</a></li>
            )}
          </ul>
        </div>
      </div>
      <div class="container mx-auto px-4 sm:px-6 mt-4 md:mt-8 pt-3 md:pt-6 md:border-t border-[var(--color-fg-muted)]/20 text-center text-[var(--color-fg-subtle)] text-[11px] md:text-[12px]">
        &copy; {new Date().getFullYear()} Los Meal Preps. All rights reserved.
      </div>
    </footer>
  </body>
</html>
